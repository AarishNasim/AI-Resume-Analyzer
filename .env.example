# Required in production. Generate a long random value; never commit the real value.
SECRET_KEY=
APP_ENV=production

# Set this to the exact deployed frontend origin, without a trailing slash.
FRONTEND_URL=

# Optional comma-separated additional allowed origins.
CORS_ORIGINS=

# Optional Railway Volume paths. Defaults are suitable for local development.
DATABASE_PATH=resume_analyzer.db
UPLOADS_DIR=uploads

# Railway provides PORT automatically. This is only useful for local runs.
PORT=5000