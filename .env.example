# Required in production. Generate a long random value; never commit the real value.
SECRET_KEY=
APP_ENV=production
DATA_BACKEND=firebase

# Set this to the exact deployed frontend origin, without a trailing slash.
FRONTEND_URL=

# Optional comma-separated additional allowed origins.
CORS_ORIGINS=

# Optional Railway Volume paths. Defaults are suitable for local development.
DATABASE_PATH=resume_analyzer.db
UPLOADS_DIR=uploads

# Railway provides PORT automatically. This is only useful for local runs.
PORT=5000

# Firebase Admin SDK. Prefer Railway variable references or a secret manager.
# Never commit the service-account JSON or its private key.
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_SERVICE_ACCOUNT_JSON=
# Alternative for local development only; keep the file outside version control.
FIREBASE_SERVICE_ACCOUNT_PATH=

# Gmail SMTP OTP delivery. Use a Gmail App Password, never your account password.
EMAIL_USER=
EMAIL_APP_PASSWORD=
EMAIL_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
OTP_SEND_COOLDOWN_SECONDS=60